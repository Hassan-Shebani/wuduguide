*{box-sizing:border-box}html{height:100%}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:"Segoe UI",Tahoma,"Noto Naskh Arabic","Geeza Pro",Arial,sans-serif}
header{padding:10px 22px;border-bottom:2px solid var(--red);display:flex;gap:12px;align-items:center;flex-wrap:wrap}
h1{margin:0;font-size:clamp(16px,2vw,24px);color:var(--red);flex:1}
.dots{display:flex;gap:5px}.dots i{width:26px;height:7px;border-radius:4px;background:var(--line);cursor:pointer;transition:.3s}.dots i.on{background:var(--red)}.dots i.done{background:var(--green)}
.wrap{display:grid;grid-template-columns:1fr 1fr;gap:18px;padding:16px clamp(14px,3vw,40px);max-width:1200px;margin:auto}
@media(max-width:820px){.wrap{grid-template-columns:1fr}}
.stage{background:linear-gradient(145deg,var(--card),var(--soft));border:1px solid var(--line);border-radius:16px;padding:8px;display:flex;justify-content:center;overflow:hidden}
svg{width:100%;max-width:430px;height:auto}
.panel{display:flex;flex-direction:column;gap:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 18px}
.num{color:var(--mut);font-size:14px}
h2{margin:2px 0 6px;font-size:clamp(24px,3.2vw,38px);color:var(--red)}
.bd{display:inline-block;padding:3px 14px;border-radius:14px;color:#fff;font-weight:700;font-size:14px;margin-inline-start:8px;vertical-align:middle}
.bd.f{background:var(--green)}.bd.s{background:var(--gold)}
p{margin:6px 0;font-size:clamp(16px,1.8vw,22px);line-height:1.9}
.note{border-inline-start:5px solid var(--gold);background:var(--soft)}
.trk{display:flex;flex-wrap:wrap;gap:7px}
.chip{padding:5px 12px;border-radius:16px;border:1px solid var(--line);color:var(--mut);font-size:15px;transition:.4s}
.chip.on{background:var(--green);border-color:var(--green);color:#fff;font-weight:700}
.ctl{display:flex;gap:8px;flex-wrap:wrap}
.voicebox{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.voicebox audio{width:min(100%,360px);height:38px}.voicebox .hint{flex:1;min-width:180px}
.quiz{display:none;border-inline-start:5px solid var(--green)}.quiz.show{display:block}.quiz h3{margin:0 0 8px;color:var(--green);font-size:22px}.qitem{padding:10px 0;border-top:1px solid var(--line)}.qitem:first-of-type{border-top:0}.qitem p{font-size:17px;font-weight:700;margin:2px 0 7px}.opts{display:grid;gap:6px}.opts label{display:block;padding:7px 10px;border:1px solid var(--line);border-radius:9px;cursor:pointer;font-size:15px}.opts label:hover{background:var(--soft)}.quiz-result{font-weight:700;margin:10px 0 0}.quiz-result.good{color:var(--green)}.quiz-result.warn{color:var(--red)}
button{font:inherit;font-size:15px;padding:9px 18px;border-radius:10px;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
button.pri{background:var(--red);border-color:var(--red);color:#fff}button.on{background:var(--gold);color:#fff;border-color:var(--gold)}
.hint{color:var(--mut);font-size:13px}
.wet{stroke:var(--water);fill:var(--water);opacity:0;transition:opacity .5s}.wet.on{opacity:.45}
path.wet{fill:none}
.drop{fill:var(--water);opacity:0}.dr .drop{animation:fall 1.1s infinite}
.dr .drop:nth-child(2){animation-delay:.35s}.dr .drop:nth-child(3){animation-delay:.7s}
@keyframes fall{0%{opacity:0;transform:translateY(0)}20%{opacity:.9}100%{opacity:0;transform:translateY(46px)}}
</style>
